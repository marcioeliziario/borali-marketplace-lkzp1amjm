# Variáveis de ambiente para desenvolvimento (exemplo)
# Copie este arquivo para .env e preencha com os valores reais

# URL do PocketBase (backend)
VITE_POCKETBASE_URL=https://seu-servidor-pocketbase.local

# Chave de homologação (opcional, usada em testes de isolamento)
BORALI_HOMOLOG_KEY=sua-chave-aqui

# Senha do usuário de teste (Mercadinho)
BORALI_TEST_USER_PASS=sua-senha-aqui

# Credenciais de homologação para comerciantes piloto
HOMOLOG_MERC_PASSWORD=sua-senha-aqui
HOMOLOG_MERCADINHO_PASSWORD=sua-senha-aqui
HOMOLOG_BARBOSA_PASSWORD=sua-senha-aqui

# URL base para testes de homologação
HOMOLOG_BASE_URL=https://seu-servidor-homolog.local

# Senhas de acesso para contas de teste específicas
HOMOLOG_PASS_BARBOSA=sua-senha-aqui
HOMOLOG_PASS_MERCADINHO=sua-senha-aqui